# --- Opportunity Engine configuration ---
# Copy to .env and fill in. Never commit .env.

# Anthropic API key. Leave blank to run in MOCK mode (deterministic heuristic agents, no network calls).
ANTHROPIC_API_KEY=

# Claude model used by all agents. Default is claude-opus-5.
CLAUDE_MODEL=claude-opus-5
# Effort level for agent calls: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# Max output tokens per agent call
CLAUDE_MAX_TOKENS=8000

# Force mock LLM even if a key is present (useful for tests). true|false
LLM_MOCK=false

# SQLite database location
DATABASE_URL=sqlite:///./data/opportunity_engine.db

# Web server
HOST=0.0.0.0
PORT=8000

# Background scheduler (source polling + pipeline). true|false
SCHEDULER_ENABLED=true
# Minutes between source scans
SCAN_INTERVAL_MINUTES=30

# Optional: comma-separated RSS/Atom feed URLs of opportunity listings you are permitted to consume
RSS_FEED_URLS=
# Optional: comma-separated JSON endpoint URLs returning arrays of opportunities
JSON_FEED_URLS=

# --- PDF ingestion: reuses the existing local Stirling PDF container (no third-party OCR, documents stay local)
PDF_INGESTION_ENABLED=true
# From inside the opportunity-engine container, host.docker.internal is the Lenovo host (see docker-compose extra_hosts).
# Running without Docker on the same machine: http://127.0.0.1:8080
PDF_SERVICE_URL=http://host.docker.internal:8080
PDF_SERVICE_TYPE=stirling
PDF_REQUEST_TIMEOUT_SECONDS=120
# Only needed if Stirling has login/security enabled (sent as X-API-KEY)
PDF_SERVICE_API_KEY=
# Tesseract languages for scanned PDFs, comma-separated
PDF_OCR_LANGUAGES=eng
PDF_MAX_FILE_MB=40
# Hosts from which attachments may be downloaded automatically (others require manual upload)
PDF_DOWNLOAD_ALLOWED_HOSTS=sam.gov,api.sam.gov,beta.sam.gov

# --- Phase 2: SAM.gov federal opportunities (official API, https://open.gsa.gov/api/get-opportunities-public-api/)
# Free key from https://api.data.gov/signup/ . Leave blank to keep the adapter disabled.
SAM_GOV_API_KEY=
# Filter by NAICS codes (comma-separated). Common IT services: 541511 541512 541519 518210 541611
SAM_GOV_NAICS=
# Optional title keywords, searched one at a time (e.g. automation,data migration,Salesforce)
SAM_GOV_KEYWORDS=
# Notice types: o=solicitation k=combined synopsis/solicitation p=presolicitation r=sources sought s=special notice
SAM_GOV_NOTICE_TYPES=o,k,p
SAM_GOV_DAYS_BACK=7
SAM_GOV_MAX_RESULTS=50

# Notification adapters. Only "dashboard" is enabled by default and nothing is sent externally.
# External adapters (ntfy, email, slack, sms) are stubs and require explicit configuration + approval.
NOTIFY_ADAPTERS=dashboard
NTFY_URL=
NTFY_TOPIC=

# Owner profile: the ONLY verified facts the proposal agent may claim. Keep it honest.
OWNER_NAME=
OWNER_TITLE=Independent automation & integration consultant
OWNER_TIMEZONE=America/New_York
