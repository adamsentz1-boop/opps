# --- Opportunity Engine configuration ---
# Copy to .env and fill in. Never commit .env.

# Anthropic API key. Leave blank to run in MOCK mode (deterministic heuristic agents, no network calls).
ANTHROPIC_API_KEY=

# Claude model used by all agents. Default is claude-opus-5.
CLAUDE_MODEL=claude-opus-5
# Effort level for agent calls: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# Max output tokens per agent call
CLAUDE_MAX_TOKENS=8000

# Force mock LLM even if a key is present (useful for tests). true|false
LLM_MOCK=false

# SQLite database location
DATABASE_URL=sqlite:///./data/opportunity_engine.db

# Web server
HOST=0.0.0.0
PORT=8000

# Background scheduler (source polling + pipeline). true|false
SCHEDULER_ENABLED=true
# Minutes between source scans
SCAN_INTERVAL_MINUTES=30

# Optional: comma-separated RSS/Atom feed URLs of opportunity listings you are permitted to consume
RSS_FEED_URLS=
# Optional: comma-separated JSON endpoint URLs returning arrays of opportunities
JSON_FEED_URLS=

# Notification adapters. Only "dashboard" is enabled by default and nothing is sent externally.
# External adapters (ntfy, email, slack, sms) are stubs and require explicit configuration + approval.
NOTIFY_ADAPTERS=dashboard
NTFY_URL=
NTFY_TOPIC=

# Owner profile: the ONLY verified facts the proposal agent may claim. Keep it honest.
OWNER_NAME=
OWNER_TITLE=Independent automation & integration consultant
OWNER_TIMEZONE=America/New_York

# --- Market Challenge (research + proposals only; the software NEVER connects to a brokerage) ---
MARKET_CHALLENGE_ENABLED=true
# Read-only market data provider: yfinance | mock
MARKET_DATA_PROVIDER=yfinance
# Force deterministic fake prices (tests / offline). true|false
MARKET_MOCK=false
# Permitted universe (V1: long-only cash account, fractional shares). Never options/futures/forex/crypto/leverage.
MARKET_ALLOWED_ASSET_TYPES=stocks,etfs
# Challenge defaults (used when the challenge row is first created; editable later at /market/settings)
MARKET_STARTING_CAPITAL=200
MARKET_TARGET_VALUE=1000
MARKET_TARGET_DATE=2027-01-01
# Portfolio-construction limits (defaults for the editable settings)
MARKET_MAX_POSITION_PCT=60
MARKET_MAX_SINGLE_TRADE_PCT=60
MARKET_MIN_CASH_RESERVE_PCT=0
# Scheduled market scan (data -> research -> proposal). It never trades.
MARKET_SCAN_ENABLED=true
MARKET_SCAN_INTERVAL_MINUTES=60
# Hours before an un-actioned proposal expires
MARKET_PROPOSAL_TTL_HOURS=72
# Optional model/effort overrides for the market agents (blank = CLAUDE_MODEL / CLAUDE_EFFORT)
MARKET_MODEL=
MARKET_EFFORT=
