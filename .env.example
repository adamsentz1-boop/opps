# --- Opportunity Engine configuration ---
# Copy to .env and fill in. Never commit .env.

# Anthropic API key. Leave blank to run in MOCK mode (deterministic heuristic agents, no network calls).
ANTHROPIC_API_KEY=

# Claude model used by all agents. Default is claude-opus-5.
CLAUDE_MODEL=claude-opus-5
# Effort level for agent calls: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# Max output tokens per agent call
CLAUDE_MAX_TOKENS=8000

# Force mock LLM even if a key is present (useful for tests). true|false
LLM_MOCK=false

# SQLite database location
DATABASE_URL=sqlite:///./data/opportunity_engine.db

# Web server
HOST=0.0.0.0
PORT=8000

# Background scheduler (source polling + pipeline). true|false
SCHEDULER_ENABLED=true
# Minutes between source scans
SCAN_INTERVAL_MINUTES=30

# Optional: comma-separated RSS/Atom feed URLs of opportunity listings you are permitted to consume
RSS_FEED_URLS=
# Optional: comma-separated JSON endpoint URLs returning arrays of opportunities
JSON_FEED_URLS=

# --- Contract-AI RFP intake (official/permitted access only; nothing here scrapes) ---
# Subscriber feeds from RFP aggregators you pay for, kept separate from the freelance feeds above so the
# contract-AI relevance filter only applies where it should.
RFP_RSS_FEED_URLS=
RFP_JSON_FEED_URLS=
# Drop off-domain notices before they reach the database (and before any tokens are spent). true|false
RFP_FILTER_ENABLED=true
# Relevance score required to keep a notice. Core terms score 3, document-AI terms 2, context terms 1.
RFP_MIN_RELEVANCE=3
# Comma-separated extra terms scored as "core" (product names, your niche vocabulary)
RFP_EXTRA_TERMS=

# SAM.gov federal contract opportunities via the official public API.
# Free key: https://open.gsa.gov/api/get-opportunities-public-api/ . Blank = source is skipped.
# Bidding also needs an active SAM.gov entity registration (UEI) - an owner step, never automated.
SAM_GOV_API_KEY=
SAM_GOV_NAICS=541511,541512,541519,541990,561410,518210,541199
# Notice types: o=Solicitation p=Presolicitation k=Combined Synopsis r=Sources Sought
SAM_GOV_PTYPES=o,p,k,r
SAM_GOV_POSTED_DAYS=7
SAM_GOV_LIMIT=100
# Fetch each notice body (one extra API call per notice). true|false
SAM_GOV_FETCH_DESCRIPTIONS=true

# Notification adapters. Only "dashboard" is enabled by default and nothing is sent externally.
# External adapters (ntfy, email, slack, sms) are stubs and require explicit configuration + approval.
NOTIFY_ADAPTERS=dashboard
NTFY_URL=
NTFY_TOPIC=

# Owner profile: the ONLY verified facts the proposal agent may claim. Keep it honest.
OWNER_NAME=
OWNER_TITLE=Independent automation & integration consultant
OWNER_TIMEZONE=America/New_York

# --- Market Challenge (research + proposals only; the software NEVER connects to a brokerage) ---
MARKET_CHALLENGE_ENABLED=true
# Read-only market data provider: yfinance | mock
MARKET_DATA_PROVIDER=yfinance
# Force deterministic fake prices (tests / offline). true|false
MARKET_MOCK=false
# Permitted universe (V1: long-only cash account, fractional shares). Never options/futures/forex/crypto/leverage.
MARKET_ALLOWED_ASSET_TYPES=stocks,etfs
# Challenge defaults (used when the challenge row is first created; editable later at /market/settings)
MARKET_STARTING_CAPITAL=200
MARKET_TARGET_VALUE=1000
MARKET_TARGET_DATE=2027-01-01
# Portfolio-construction limits (defaults for the editable settings)
MARKET_MAX_POSITION_PCT=60
MARKET_MAX_SINGLE_TRADE_PCT=60
MARKET_MIN_CASH_RESERVE_PCT=0
# Risk management. Every proposed entry carries a stop, and the position is sized so that being stopped out
# costs no more than MARKET_MAX_RISK_PER_TRADE_PCT of portfolio value. This is usually the binding constraint.
MARKET_MAX_RISK_PER_TRADE_PCT=10
# Stop distance = this many average daily moves below the entry, clamped into the band below.
MARKET_STOP_MOVE_MULTIPLE=2.5
MARKET_MIN_STOP_PCT=5
MARKET_MAX_STOP_PCT=25
# Target distance as a multiple of the stop distance (2.0 = risk 1 to make 2)
MARKET_REWARD_RISK_TARGET=2.0
# Days of price history fetched for the statistics that drive the stop
MARKET_HISTORY_DAYS=60
# Propose a SELL when an open position breaches its stop or target. true|false
MARKET_EXIT_MONITOR_ENABLED=true
# Scheduled market scan (data -> research -> proposal). It never trades.
MARKET_SCAN_ENABLED=true
MARKET_SCAN_INTERVAL_MINUTES=60
# Hours before an un-actioned proposal expires
MARKET_PROPOSAL_TTL_HOURS=72
# Optional model/effort overrides for the market agents (blank = CLAUDE_MODEL / CLAUDE_EFFORT)
MARKET_MODEL=
MARKET_EFFORT=
